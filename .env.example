# Copia este fichero como .env y rellena los valores reales.
# El fichero .env NUNCA debe commitearse (ya está en .gitignore).

# ── Backend LLM ──
# "ollama" = extracción local con Ollama (desarrollo, privacidad)
# "api"    = extracción via Groq/OpenAI (deploy cloud, rapidez)
LLM_BACKEND=ollama

# ── Groq API (solo si LLM_BACKEND=api) ──
# Obtén una clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI API (alternativa a Groq) ──
# OPENAI_API_KEY=
